# ══════════════════════════════════════════════════
#  PROXILIO — Variables d'environnement production
#  Copier ce fichier en .env et remplir les valeurs
# ══════════════════════════════════════════════════

# ── Base de données ─────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=proxilio_production
DB_USER=proxilio
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ─────────────────────────────────────────
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING

# ── Stripe ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email SMTP IONOS ────────────────────────────
EMAIL=contact@proxilio.fr
SMTP_USER=contact@proxilio.fr
SMTP_PASS=CHANGE_ME_IONOS_MAIL_PASSWORD

# ── App ─────────────────────────────────────────
NODE_ENV=production
PORT=3000
CLIENT_URL=https://proxilio.fr

# ── Frontend (build-time Vite) ───────────────────
VITE_API_URL=https://proxilio.fr/api/
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
